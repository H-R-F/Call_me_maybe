		{
			"type": "text",
			"version": 2,
			"x": 70,
			"y": 100,
			"width": 640,
			"height": 100,
			"strokeColor": "#f0f6fc",
			"backgroundColor": "transparent",
			"text": "\"\"\"Project package.\"\"\"\n\n📌 This is the only line in the file.\n📌 It makes src/ a Python package so `from .decoder import decode` works.\n📌 Without it, `python -m src` would fail with \"No module named src\".",
			"fontSize": 13,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "top",
			"id": "code_text",
			"roughness": 0,
			"opacity": 100,
			"elementType": "text",
			"containerId": "box_code",
			"originalText": "\"\"\"Project package.\"\"\"\n\n📌 This is the only line in the file.\n📌 It makes src/ a Python package so `from .decoder import decode` works.\n📌 Without it, `python -m src` would fail with \"No module named src\".",
			"autoResize": true,
			"lineHeight": 1.25,
			"versionNonce": 1,
			"index": "a2",
			"isDeleted": false,
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"angle": 0,
			"seed": 4,
			"groupIds": [],
			"frameId": null,
			"roundness": null,
			"boundElements": [],
			"updated": 1781438000000,
			"link": null,
			"hasTextLink": false,
			"locked": false,
			"rawText": ""
		},
		{
			"type": "text",
			"version": 2,
			"x": 60,
			"y": 230,
			"width": 660,
			"height": 110,
			"strokeColor": "#7ee787",
			"backgroundColor": "transparent",
			"text": "🔍 So what does an __init__.py do?\n\n• Tells Python \"this directory is a package\" — enables `import src` and `from src import ...`\n• Can be empty (or contain a docstring like here), or re-export names for a clean public API\n• In this project: it's purely a marker — all the logic lives in sibling modules\n• Python 3.3+ has implicit namespace packages (no __init__.py needed), but explicit is better",
			"fontSize": 13,
			"fontFamily": 1,
			"textAlign": "left",
			"verticalAlign": "top",
			"id": "explanation",
			"roughness": 0,
			"opacity": 100,
			"elementType": "text",
			"containerId": null,
			"originalText": "🔍 So what does an __init__.py do?\n\n• Tells Python \"this directory is a package\" — enables `import src` and `from src import ...`\n• Can be empty (or contain a docstring like here), or re-export names for a clean public API\n• In this project: it's purely a marker — all the logic lives in sibling modules\n• Python 3.3+ has implicit namespace packages (no __init__.py needed), but explicit is better",
			"autoResize": true,
			"lineHeight": 1.25,
			"versionNonce": 1,
			"index": "a3",
			"isDeleted": false,
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"angle": 0,
			"seed": 5,
			"groupIds": [],
			"frameId": null,
			"roundness": null,
			"boundElements": [],
			"updated": 1781438000000,
			"link": null,
			"hasTextLink": false,
			"locked": false,
			"rawText": ""
		},
		{
			"type": "text",
			"version": 2,
			"x": 60,
			"y": 360,
			"width": 660,
			"height": 60,
			"strokeColor": "#d2a8ff",
			"backgroundColor": "transparent",
			"text": "🔗 Why this matters for the project\n\nThe package structure is:\n  src/\n    __init__.py    ← you are here\n    __main__.py    ← entry point: calls cli.main()\n    cli.py         ← argparse layer\n    pipeline.py    ← orchestrator\n    decoder.py     ← constrained decoding (the core logic)\n    io_utils.py    ← file I/O + Pydantic validation\n    schema.py      ← Pydantic models\n\nAll relative imports (from .decoder import decode) depend on this __init__.py existing.",
			"fontSize": 13,
			"fontFamily": 1,
			"textAlign": "left",
			"verticalAlign": "top",
			"id": "structure",
			"roughness": 0,
			"opacity": 100,
			"elementType": "text",
			"containerId": null,
			"originalText": "🔗 Why this matters for the project\n\nThe package structure is:\n  src/\n    __init__.py    ← you are here\n    __main__.py    ← entry point: calls cli.main()\n    cli.py         ← argparse layer\n    pipeline.py    ← orchestrator\n    decoder.py     ← constrained decoding (the core logic)\n    io_utils.py    ← file I/O + Pydantic validation\n    schema.py      ← Pydantic models\n\nAll relative imports (from .decoder import decode) depend on this __init__.py existing.",
			"autoResize": true,
			"lineHeight": 1.25,
			"versionNonce": 1,
