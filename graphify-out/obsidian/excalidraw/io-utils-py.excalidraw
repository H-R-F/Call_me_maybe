		{
			"type": "text",
			"version": 20,
			"x": 39.16859490718585,
			"y": 320,
			"width": 220.3125,
			"height": 86.39999999999999,
			"strokeColor": "#f0883e",
			"backgroundColor": "transparent",
			"text": "🟠 _validate_model(model_type, data) → ModelT\n\n▸ Takes a Pydantic model class + raw dict\n▸ Tries model_validate() first (Pydantic v2)\n▸ Falls back to parse_obj() (Pydantic v1)\n▸ Returns typed model or raises ValidationError\n\n▸ Uses TypeVar to preserve the type —\n  mypy knows the return type matches the input",
			"fontSize": 8,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "middle",
			"id": "mK1D6k34",
			"roughness": 0,
			"opacity": 100,
			"elementType": "text",
			"containerId": null,
			"originalText": "🟠 _validate_model(model_type, data) → ModelT\n\n▸ Takes a Pydantic model class + raw dict\n▸ Tries model_validate() first (Pydantic v2)\n▸ Falls back to parse_obj() (Pydantic v1)\n▸ Returns typed model or raises ValidationError\n\n▸ Uses TypeVar to preserve the type —\n  mypy knows the return type matches the input",
			"autoResize": true,
			"lineHeight": 1.2,
			"versionNonce": 858893490,
			"index": "aF",
			"isDeleted": false,
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"angle": 0,
			"seed": 1,
			"groupIds": [],
			"frameId": null,
			"roundness": null,
			"boundElements": [],
			"updated": 1781543908559,
			"hasTextLink": false,
			"locked": false,
			"rawText": "🟠 _validate_model(model_type, data) → ModelT\n\n▸ Takes a Pydantic model class + raw dict\n▸ Tries model_validate() first (Pydantic v2)\n▸ Falls back to parse_obj() (Pydantic v1)\n▸ Returns typed model or raises ValidationError\n\n▸ Uses TypeVar to preserve the type —\n  mypy knows the return type matches the input"
		},
