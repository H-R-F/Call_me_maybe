		{
			"type": "text",
			"version": 9,
			"x": 35,
			"y": 240.4,
			"width": 490.4296875,
			"height": 43.199999999999996,
			"strokeColor": "#8b949e",
			"backgroundColor": "transparent",
			"text": "ModelT = TypeVar(\"ModelT\", bound=BaseModel)\n▸ A generic type variable that must be a subclass of BaseModel\n▸ Used in _validate_model to keep the return type linked to the input model class\n▸ If you pass FunctionDefinition, you get list[FunctionDefinition] back — mypy knows the type",
			"fontSize": 9,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "middle",
			"id": "tvar-box",
			"roughness": 0,
			"opacity": 100,
			"elementType": "text",
			"containerId": "ul9cRA7sX_KLP0ESaT8ke",
			"originalText": "ModelT = TypeVar(\"ModelT\", bound=BaseModel)\n▸ A generic type variable that must be a subclass of BaseModel\n▸ Used in _validate_model to keep the return type linked to the input model class\n▸ If you pass FunctionDefinition, you get list[FunctionDefinition] back — mypy knows the type",
			"autoResize": true,
