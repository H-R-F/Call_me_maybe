		{
			"type": "text",
			"version": 60,
			"x": 39.70931150800584,
			"y": 591.5967692596712,
			"width": 531.1067504882812,
			"height": 62.5,
			"strokeColor": "#f0f6fc",
			"backgroundColor": "transparent",
			"text": "1️⃣ pipeline.py calls load_function_definitions() → reads functions_definition.json → validates with Pydantic\n2️⃣ pipeline.py calls load_prompts() → reads function_calling_tests.json → validates with Pydantic\n3️⃣ For each prompt: decoder.decode() selects the right function + extracts parameters\n4️⃣ The LLM never picks a function that doesn't exist — the trie physically prevents it\n5️⃣ Result: { prompt, name: \"fn_add_numbers\", parameters: { a: 2, b: 3 } }",
			"fontSize": 10,
			"fontFamily": 1,
			"textAlign": "left",
			"verticalAlign": "top",
			"id": "how-body",
			"roughness": 0,
			"opacity": 100,
			"elementType": "text",
			"containerId": null,
			"originalText": "1️⃣ pipeline.py calls load_function_definitions() → reads functions_definition.json → validates with Pydantic\n2️⃣ pipeline.py calls load_prompts() → reads function_calling_tests.json → validates with Pydantic\n3️⃣ For each prompt: decoder.decode() selects the right function + extracts parameters\n4️⃣ The LLM never picks a function that doesn't exist — the trie physically prevents it\n5️⃣ Result: { prompt, name: \"fn_add_numbers\", parameters: { a: 2, b: 3 } }",
			"autoResize": true,
			"lineHeight": 1.25,
			"versionNonce": 321894630,
