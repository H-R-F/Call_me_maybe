			"strokeColor": "#d2a8ff",
			"backgroundColor": "transparent",
			"text": "src/cli.py\nmain()\n\nparses sys.argv\ncalls pipeline.run_pipeline()",
			"fontSize": 12,
			"fontFamily": 1,
			"textAlign": "center",
			"verticalAlign": "middle",
			"id": "fSwh82VU",
			"roughness": 0,
			"opacity": 100,
			"elementType": "text",
			"containerId": "box_cli_py",
			"originalText": "src/cli.py\nmain()\n\nparses sys.argv\ncalls pipeline.run_pipeline()",
			"autoResize": true,
			"lineHeight": 1.25,
			"versionNonce": 1120546267,
			"index": "a4",
			"isDeleted": false,
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"angle": 0,
			"seed": 9,
			"groupIds": [],
			"frameId": null,
			"roundness": null,
