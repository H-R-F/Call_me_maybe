		},
		{
			"type": "text",
			"version": 60,
			"x": 60,
			"y": 380,
			"width": 623.2203979492188,
			"height": 130,
			"strokeColor": "#ffa657",
			"backgroundColor": "transparent",
			"text": "🔍 Key Python concepts demonstrated\n\n• `if __name__ == \"__main__\":` — the classic Python guard. Every module has a __name__;\n  when run directly it's \"__main__\", when imported it's the module path (e.g. \"src.__main__\")\n• Relative import `from .cli import main` — the dot means \"sibling package\"\n• __main__.py is the module Python looks for when you use `python -m`\n• The file delegates everything — it's a thin entry point that hands off to cli.main()\n• This pattern is idiomatic: keep __main__.py tiny, put logic in importable modules",
			"fontSize": 13,
			"fontFamily": 1,
			"textAlign": "left",
			"verticalAlign": "top",
			"id": "Zaw5W3hy",
			"roughness": 0,
			"opacity": 100,
			"elementType": "text",
			"containerId": null,
			"originalText": "🔍 Key Python concepts demonstrated\n\n• `if __name__ == \"__main__\":` — the classic Python guard. Every module has a __name__;\n  when run directly it's \"__main__\", when imported it's the module path (e.g. \"src.__main__\")\n• Relative import `from .cli import main` — the dot means \"sibling package\"\n• __main__.py is the module Python looks for when you use `python -m`\n• The file delegates everything — it's a thin entry point that hands off to cli.main()\n• This pattern is idiomatic: keep __main__.py tiny, put logic in importable modules",
			"autoResize": true,
			"lineHeight": 1.25,
			"versionNonce": 1218212181,
			"index": "a5",
			"isDeleted": false,
			"fillStyle": "solid",
