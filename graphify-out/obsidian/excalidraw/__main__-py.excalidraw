			"width": 549.42333984375,
			"height": 146.25,
			"strokeColor": "#f0f6fc",
			"backgroundColor": "transparent",
			"text": "\"\"\"Module entry point.\"\"\"\n\nfrom .cli import main\n\nif __name__ == \"__main__\":\n    main()\n\n📌 Line 3: relative import — fetches main() from sibling cli.py\n📌 Lines 6-7: runs main() only when executed directly, not when imported",
			"fontSize": 13,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "top",
			"id": "1NpKQd8c",
			"roughness": 0,
			"opacity": 100,
			"elementType": "text",
			"containerId": "box_code",
			"originalText": "\"\"\"Module entry point.\"\"\"\n\nfrom .cli import main\n\nif __name__ == \"__main__\":\n    main()\n\n📌 Line 3: relative import — fetches main() from sibling cli.py\n📌 Lines 6-7: runs main() only when executed directly, not when imported",
