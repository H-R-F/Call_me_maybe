		{
			"type": "text",
			"version": 78,
			"x": 65.79027814098197,
			"y": 570,
			"width": 503.90625,
			"height": 100,
			"strokeColor": "#58a6ff",
			"backgroundColor": "transparent",
			"text": "functions = load_function_definitions(functions_definition_path)\n  └─► 1. Path(path).read_text(encoding=\"utf-8\")        ← opens file, reads all bytes\n  └─► 2. json.loads(raw_text)                           ← parses JSON into Python list\n  └─► 3. isinstance(data, list)                         ← guards: must be JSON array\n  └─► 4. [_validate_model(FunctionDefinition, item) for item in data]\n         └─► Pydantic validates name, description, parameters, returns\n         └─► Returns 5 objects: fn_add_numbers, fn_greet, fn_reverse_string,\n                                 fn_get_square_root, fn_substitute_string_with_regex",
			"fontSize": 10,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "top",
			"id": "el11",
			"roughness": 0,
			"opacity": 100,
			"elementType": "text",
			"containerId": null,
			"originalText": "functions = load_function_definitions(functions_definition_path)\n  └─► 1. Path(path).read_text(encoding=\"utf-8\")        ← opens file, reads all bytes\n  └─► 2. json.loads(raw_text)                           ← parses JSON into Python list\n  └─► 3. isinstance(data, list)                         ← guards: must be JSON array\n  └─► 4. [_validate_model(FunctionDefinition, item) for item in data]\n         └─► Pydantic validates name, description, parameters, returns\n         └─► Returns 5 objects: fn_add_numbers, fn_greet, fn_reverse_string,\n                                 fn_get_square_root, fn_substitute_string_with_regex",
