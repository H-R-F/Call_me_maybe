		{
			"type": "text",
			"version": 44,
			"x": 65,
			"y": 1515,
			"width": 378.515625,
			"height": 201.875,
			"strokeColor": "#58a6ff",
			"backgroundColor": "transparent",
			"text": "write_output(output_path, outputs)\n  └─► 1. Path(path).parent.mkdir(parents=True, exist_ok=True)\n         └─► Creates data/output/ if it doesn't exist\n  └─► 2. payload = [item.model_dump() for item in outputs]\n         └─► Converts 11 OutputItem Pydantic models → plain dicts\n  └─► 3. content = json.dumps(payload, ensure_ascii=False, indent=2)\n         └─► Pretty-prints the JSON with 2-space indentation\n  └─► 4. Path(path).write_text(content, encoding=\"utf-8\")\n         └─► Writes to data/output/function_calling_results.json\n         └─► Creates file if missing, overwrites if existing\n\nExample output entry:\n{\n  \"prompt\": \"What is the sum of 2 and 3?\",\n  \"name\": \"fn_add_numbers\",\n  \"parameters\": { \"a\": 2.0, \"b\": 3.0 }\n}",
			"fontSize": 9.5,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "top",
			"id": "el29",
			"roughness": 0,
			"opacity": 100,
			"elementType": "text",
			"containerId": null,
			"originalText": "write_output(output_path, outputs)\n  └─► 1. Path(path).parent.mkdir(parents=True, exist_ok=True)\n         └─► Creates data/output/ if it doesn't exist\n  └─► 2. payload = [item.model_dump() for item in outputs]\n         └─► Converts 11 OutputItem Pydantic models → plain dicts\n  └─► 3. content = json.dumps(payload, ensure_ascii=False, indent=2)\n         └─► Pretty-prints the JSON with 2-space indentation\n  └─► 4. Path(path).write_text(content, encoding=\"utf-8\")\n         └─► Writes to data/output/function_calling_results.json\n         └─► Creates file if missing, overwrites if existing\n\nExample output entry:\n{\n  \"prompt\": \"What is the sum of 2 and 3?\",\n  \"name\": \"fn_add_numbers\",\n  \"parameters\": { \"a\": 2.0, \"b\": 3.0 }\n}",
			"autoResize": true,
