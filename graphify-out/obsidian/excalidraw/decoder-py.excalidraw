    {
      "type": "text",
      "version": 19,
      "x": 425,
      "y": 395,
      "width": 304.6875,
      "height": 150,
      "strokeColor": "#ffa657",
      "backgroundColor": "transparent",
      "text": "🌳 Visual: The Trie for 5 functions\n\n  root\n   ├── [token_1042] → fn_add_numbers (terminal)\n   ├── [token_855] → fn_greet (terminal)\n   ├── [token_993] → fn_reverse_string (terminal)\n   ├── [token_402] → fn_get_square_root (terminal)\n   └── [token_670] → fn_substitute_string_with_regex\n(terminal)\n\n(Each function fits in 1 token for simple names, but\ncould span multiple)",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "id": "dvvrofVL",
      "roughness": 0,
      "opacity": 100,
      "elementType": "text",
      "containerId": "box_build_tree",
      "originalText": "🌳 Visual: The Trie for 5 functions\n\n  root\n   ├── [token_1042] → fn_add_numbers (terminal)\n   ├── [token_855] → fn_greet (terminal)\n   ├── [token_993] → fn_reverse_string (terminal)\n   ├── [token_402] → fn_get_square_root (terminal)\n   └── [token_670] → fn_substitute_string_with_regex (terminal)\n\n(Each function fits in 1 token for simple names, but could span multiple)",
      "autoResize": true,
      "lineHeight": 1.25,
