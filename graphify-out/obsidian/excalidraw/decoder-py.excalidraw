    {
      "type": "text",
      "version": 3,
      "x": 65,
      "y": 85,
      "width": 290.0390625,
      "height": 151.25,
      "strokeColor": "#d2a8ff",
      "backgroundColor": "transparent",
      "text": "@dataclass\nclass TrieNode:\n    children: dict[int, TrieNode]\n    terminal: bool\n\nA trie where edges are token IDs, not\ncharacters.\nEach node stores next-possible token IDs + a\nflag\nindicating whether a valid function name ends\nhere.",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "id": "Zhv0zNl4",
      "roughness": 0,
      "opacity": 100,
      "elementType": "text",
      "containerId": "box_trie",
      "originalText": "@dataclass\nclass TrieNode:\n    children: dict[int, TrieNode]\n    terminal: bool\n\nA trie where edges are token IDs, not characters.\nEach node stores next-possible token IDs + a flag\nindicating whether a valid function name ends here.",
      "autoResize": true,
      "lineHeight": 1.25,
      "versionNonce": 2123680661,
