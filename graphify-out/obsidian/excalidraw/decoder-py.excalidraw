      "y": 85,
      "width": 277.1484375,
      "height": 110,
      "strokeColor": "#d2a8ff",
      "backgroundColor": "transparent",
      "text": "class DecodedCall(TypedDict):\n    name: str\n    parameters: dict[str, Any]\n\nTypedDict = a dict with fixed key names +\ntypes.\nMypy knows name is str, parameters is dict.\nNo runtime enforcement (unlike Pydantic).",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "id": "FP6WqLje",
      "roughness": 0,
      "opacity": 100,
      "elementType": "text",
      "containerId": "box_decoded",
      "originalText": "class DecodedCall(TypedDict):\n    name: str\n    parameters: dict[str, Any]\n\nTypedDict = a dict with fixed key names + types.\nMypy knows name is str, parameters is dict.\nNo runtime enforcement (unlike Pydantic).",
      "autoResize": true,
