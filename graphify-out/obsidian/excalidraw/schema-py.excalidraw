		{
			"type": "text",
			"version": 44,
			"x": 225,
			"y": 325,
			"width": 131.8359375,
			"height": 86.39999999999999,
			"strokeColor": "#f0883e",
			"backgroundColor": "transparent",
			"text": "ParameterSpec(BaseModel):\n    type: ParameterType\n\n▸ One field: \"type\"\n▸ Value must be one of\n  the 6 Literal values\n▸ Example:\n  { \"type\": \"string\" }",
			"fontSize": 9,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "middle",
			"id": "IhyBQteH",
			"roughness": 0,
