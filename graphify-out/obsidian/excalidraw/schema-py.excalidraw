		{
			"type": "text",
			"version": 80,
			"x": 37.86588476946895,
			"y": 240,
			"width": 547.6397705078125,
			"height": 37.5,
			"strokeColor": "#a371f7",
			"backgroundColor": "transparent",
			"text": "🔍  Literal explained:  Literal[\"string\", \"number\", \"integer\", \"boolean\", \"object\", \"array\"]\n    = a type that can ONLY be one of these exact 6 strings. Not \"str\", not \"int\", not \"bool\" — just these 6.\n    If someone writes { \"type\": \"float\" }, Pydantic rejects it with a validation error.",
			"fontSize": 10,
			"fontFamily": 1,
			"textAlign": "center",
			"verticalAlign": "middle",
			"id": "g9EjkJzJ",
			"roughness": 0,
			"opacity": 100,
			"elementType": "text",
			"containerId": null,
			"originalText": "🔍  Literal explained:  Literal[\"string\", \"number\", \"integer\", \"boolean\", \"object\", \"array\"]\n    = a type that can ONLY be one of these exact 6 strings. Not \"str\", not \"int\", not \"bool\" — just these 6.\n    If someone writes { \"type\": \"float\" }, Pydantic rejects it with a validation error.",
			"autoResize": true,
			"lineHeight": 1.25,
			"versionNonce": 387818406,
			"index": "aG",
			"isDeleted": false,
