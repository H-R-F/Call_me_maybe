		{
			"type": "text",
			"version": 132,
			"x": 25.297159873049196,
			"y": 346.1411088684174,
			"width": 182.8125,
			"height": 259.2,
			"strokeColor": "#3fb950",
			"backgroundColor": "transparent",
			"text": "🟢 main(argv=None) → int\n\n▸ The entry point function\n▸ argv: Sequence[str] | None\n  → None means \"use sys.argv\"\n  → passing a list lets tests\n    inject fake arguments\n▸ Returns int: 0 = success, 1 = error\n\nStep by step:\n  1. parser = _build_parser()\n     → create the argument parser\n\n  2. args = parser.parse_args(argv)\n     → parse command line / passed args\n     → args.functions_definition\n       args.input / args.output\n\n  3. run_pipeline(...)\n     → pass the 3 paths to pipeline\n\n  4. If any exception occurs:\n     → print \"Error: ...\" to stderr\n     → return 1 (failure)\n\n  5. If no exception:\n     → return 0 (success)",
			"fontSize": 8,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "middle",
			"id": "main-box",
			"roughness": 0,
			"opacity": 100,
			"elementType": "text",
			"containerId": "GDQi9ChwND6nWZBlcsRyp",
			"originalText": "🟢 main(argv=None) → int\n\n▸ The entry point function\n▸ argv: Sequence[str] | None\n  → None means \"use sys.argv\"\n  → passing a list lets tests\n    inject fake arguments\n▸ Returns int: 0 = success, 1 = error\n\nStep by step:\n  1. parser = _build_parser()\n     → create the argument parser\n\n  2. args = parser.parse_args(argv)\n     → parse command line / passed args\n     → args.functions_definition\n       args.input / args.output\n\n  3. run_pipeline(...)\n     → pass the 3 paths to pipeline\n\n  4. If any exception occurs:\n     → print \"Error: ...\" to stderr\n     → return 1 (failure)\n\n  5. If no exception:\n     → return 0 (success)",
			"autoResize": true,
			"lineHeight": 1.2,
			"versionNonce": 764391195,
			"index": "aB",
			"isDeleted": false,
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"angle": 0,
			"seed": 1,
			"groupIds": [],
			"frameId": null,
			"roundness": null,
			"boundElements": [],
			"updated": 1781604176075,
			"hasTextLink": false,
			"locked": false,
			"rawText": "🟢 main(argv=None) → int\n\n▸ The entry point function\n▸ argv: Sequence[str] | None\n  → None means \"use sys.argv\"\n  → passing a list lets tests\n    inject fake arguments\n▸ Returns int: 0 = success, 1 = error\n\nStep by step:\n  1. parser = _build_parser()\n     → create the argument parser\n\n  2. args = parser.parse_args(argv)\n     → parse command line / passed args\n     → args.functions_definition\n       args.input / args.output\n\n  3. run_pipeline(...)\n     → pass the 3 paths to pipeline\n\n  4. If any exception occurs:\n     → print \"Error: ...\" to stderr\n     → return 1 (failure)\n\n  5. If no exception:\n     → return 0 (success)"
		},
