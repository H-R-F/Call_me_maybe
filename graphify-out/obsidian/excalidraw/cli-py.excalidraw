		{
			"type": "text",
			"version": 64,
			"x": 433.9364253946335,
			"y": 350.86029421387076,
			"width": 159.375,
			"height": 240,
			"strokeColor": "#d29922",
			"backgroundColor": "transparent",
			"text": "🟡 Design decisions in cli.py:\n\n▸ main() accepts argv=None\n  → Allows testing without\n    real command-line args\n  → Tests can pass mock args:\n    main([\"--input\", \"test.json\"])\n\n▸ Error handling wraps the\n  entire pipeline:\n  → Catches ALL exceptions\n  → Prints to stderr (not stdout)\n    so output doesn't mix with\n    error messages\n  → Returns non-zero exit code\n\n▸ # noqa: BLE001\n  → Suppresses flake8 warning\n    about bare except\n  → Intentional: we want to\n    catch everything here\n\n▸ Thin layer — only 44 lines\n  → Keeps CLI logic separate\n    from pipeline logic",
			"fontSize": 8,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "middle",
			"id": "MOUU0lLO",
			"roughness": 0,
			"opacity": 100,
			"elementType": "text",
			"containerId": null,
			"originalText": "🟡 Design decisions in cli.py:\n\n▸ main() accepts argv=None\n  → Allows testing without\n    real command-line args\n  → Tests can pass mock args:\n    main([\"--input\", \"test.json\"])\n\n▸ Error handling wraps the\n  entire pipeline:\n  → Catches ALL exceptions\n  → Prints to stderr (not stdout)\n    so output doesn't mix with\n    error messages\n  → Returns non-zero exit code\n\n▸ # noqa: BLE001\n  → Suppresses flake8 warning\n    about bare except\n  → Intentional: we want to\n    catch everything here\n\n▸ Thin layer — only 44 lines\n  → Keeps CLI logic separate\n    from pipeline logic",
			"autoResize": true,
			"lineHeight": 1.2,
			"versionNonce": 1215197301,
