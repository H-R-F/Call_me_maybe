		{
			"type": "text",
			"version": 51,
			"x": 250.84120580139665,
			"y": 167.29230029344737,
			"width": 375,
			"height": 115.19999999999999,
			"strokeColor": "#f0883e",
			"backgroundColor": "transparent",
			"text": "🟠 _build_parser() → ArgumentParser\n\n▸ Creates an argparse.ArgumentParser with description=\"Call Me Maybe\"\n▸ Defines 3 optional arguments, all with default paths:\n\n   --functions_definition   → default: data/input/functions_definition.json\n   --input                  → default: data/input/function_calling_tests.json\n   --output                 → default: data/output/function_calling_results.json\n\n▸ The defaults point to the standard locations — you only need to override\n  if your files are somewhere else.\n▸ Returns the configured parser object.",
			"fontSize": 8,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "middle",
			"id": "Ly8Yyjod",
			"roughness": 0,
			"opacity": 100,
			"elementType": "text",
			"containerId": null,
			"originalText": "🟠 _build_parser() → ArgumentParser\n\n▸ Creates an argparse.ArgumentParser with description=\"Call Me Maybe\"\n▸ Defines 3 optional arguments, all with default paths:\n\n   --functions_definition   → default: data/input/functions_definition.json\n   --input                  → default: data/input/function_calling_tests.json\n   --output                 → default: data/output/function_calling_results.json\n\n▸ The defaults point to the standard locations — you only need to override\n  if your files are somewhere else.\n▸ Returns the configured parser object.",
			"autoResize": true,
			"lineHeight": 1.2,
