			"strokeColor": "#f0f6fc",
			"backgroundColor": "transparent",
			"text": "📦 Imports\n\nimport time                              # not used in this file (spare?)\nfrom typing import Tuple                  # not used either (unused import?)\nimport torch                              # tensor ops, device management\nfrom transformers import AutoModelForCausalLM, AutoTokenizer, PreTrainedTokenizer, PreTrainedModel, logging\nfrom huggingface_hub import hf_hub_download # fetches tokenizer files from HF Hub\nimport os                                 # not used in this file\n\nℹ️ Some imports appear unused — likely leftovers from development. The core ones are:\ntorch, AutoModelForCausalLM, AutoTokenizer, hf_hub_download, logging",
			"fontSize": 10,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "top",
			"id": "HvNtoJ2n",
			"roughness": 0,
			"opacity": 100,
			"elementType": "text",
			"containerId": "box_imports",
			"originalText": "📦 Imports\n\nimport time                              # not used in this file (spare?)\nfrom typing import Tuple                  # not used either (unused import?)\nimport torch                              # tensor ops, device management\nfrom transformers import AutoModelForCausalLM, AutoTokenizer, PreTrainedTokenizer, PreTrainedModel, logging\nfrom huggingface_hub import hf_hub_download # fetches tokenizer files from HF Hub\nimport os                                 # not used in this file\n\nℹ️ Some imports appear unused — likely leftovers from development. The core ones are:\ntorch, AutoModelForCausalLM, AutoTokenizer, hf_hub_download, logging",
			"autoResize": true,
			"lineHeight": 1.25,
			"versionNonce": 745442933,
