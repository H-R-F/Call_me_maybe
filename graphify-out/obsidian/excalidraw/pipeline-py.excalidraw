		{
			"type": "text",
			"version": 4,
			"x": 65,
			"y": 85,
			"width": 502.734375,
			"height": 233.75,
			"strokeColor": "#f0f6fc",
			"backgroundColor": "transparent",
			"text": "\"\"\"Generation pipeline.\"\"\"\n\nfrom typing import Any\nfrom llm_sdk import Small_LLM_Model\nfrom .decoder import decode\nfrom .io_utils import load_function_definitions, load_prompts, write_output\nfrom .schema import OutputItem\n\ndef run_pipeline(*, functions_definition_path, input_path, output_path):\n    functions = load_function_definitions(functions_definition_path)\n    prompts = load_prompts(input_path)\n    model = Small_LLM_Model()\n    for item in prompts:\n        decoded = decode(model=model, prompt=item.prompt, functions=functions)\n        outputs.append(OutputItem(prompt=item.prompt, name=decoded[\"name\"],\nparameters=decoded[\"parameters\"]))\n    write_output(output_path, outputs)",
			"fontSize": 11,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "top",
			"id": "3e79xHY3",
			"roughness": 0,
			"opacity": 100,
			"elementType": "text",
			"containerId": "box_code",
			"originalText": "\"\"\"Generation pipeline.\"\"\"\n\nfrom typing import Any\nfrom llm_sdk import Small_LLM_Model\nfrom .decoder import decode\nfrom .io_utils import load_function_definitions, load_prompts, write_output\nfrom .schema import OutputItem\n\ndef run_pipeline(*, functions_definition_path, input_path, output_path):\n    functions = load_function_definitions(functions_definition_path)\n    prompts = load_prompts(input_path)\n    model = Small_LLM_Model()\n    for item in prompts:\n        decoded = decode(model=model, prompt=item.prompt, functions=functions)\n        outputs.append(OutputItem(prompt=item.prompt, name=decoded[\"name\"],\nparameters=decoded[\"parameters\"]))\n    write_output(output_path, outputs)",
			"autoResize": true,
			"lineHeight": 1.25,
			"versionNonce": 314922779,
			"index": "a2",
			"isDeleted": false,
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"angle": 0,
			"seed": 4,
			"groupIds": [],
			"frameId": null,
			"roundness": null,
			"boundElements": [],
			"updated": 1781604945936,
			"hasTextLink": false,
			"locked": false,
			"rawText": "\"\"\"Generation pipeline.\"\"\"\n\nfrom typing import Any\nfrom llm_sdk import Small_LLM_Model\nfrom .decoder import decode\nfrom .io_utils import load_function_definitions, load_prompts, write_output\nfrom .schema import OutputItem\n\ndef run_pipeline(*, functions_definition_path, input_path, output_path):\n    functions = load_function_definitions(functions_definition_path)\n    prompts = load_prompts(input_path)\n    model = Small_LLM_Model()\n    for item in prompts:\n        decoded = decode(model=model, prompt=item.prompt, functions=functions)\n        outputs.append(OutputItem(prompt=item.prompt, name=decoded[\"name\"],\nparameters=decoded[\"parameters\"]))\n    write_output(output_path, outputs)",
			"link": null
		},
