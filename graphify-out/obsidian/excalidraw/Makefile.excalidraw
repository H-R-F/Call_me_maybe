		},
		{
			"type": "text",
			"version": 46,
			"x": -271.83863341045867,
			"y": 444.05957058301635,
			"width": 299.09979248046875,
			"height": 125,
			"strokeColor": "#c9d1d9",
			"backgroundColor": "transparent",
			"text": "📖 Two tools run together:\n\n1. flake8 = style checker. Enforces PEP 8 rules:\n   line length ≤ 100, proper spacing, naming conventions.\n\n2. mypy = static type checker. Catches bugs before runtime:\n   wrong types, missing return values, etc.\n\nThe flags make it strict: every function must have\nannotations, no silent \"Any\" types.",
			"fontSize": 10,
			"fontFamily": 1,
			"textAlign": "left",
			"verticalAlign": "top",
			"id": "qLhcaZmS",
			"roughness": 0,
			"opacity": 100,
			"elementType": "text",
			"containerId": null,
			"originalText": "📖 Two tools run together:\n\n1. flake8 = style checker. Enforces PEP 8 rules:\n   line length ≤ 100, proper spacing, naming conventions.\n\n2. mypy = static type checker. Catches bugs before runtime:\n   wrong types, missing return values, etc.\n\nThe flags make it strict: every function must have\nannotations, no silent \"Any\" types.",
			"autoResize": true,
			"lineHeight": 1.25,
			"versionNonce": 597296122,
