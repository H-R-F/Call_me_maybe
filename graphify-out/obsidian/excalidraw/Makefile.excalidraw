		{
			"type": "text",
			"version": 62,
			"x": 128.16136658954133,
			"y": 459.05957058301635,
			"width": 259.119873046875,
			"height": 112.5,
			"strokeColor": "#c9d1d9",
			"backgroundColor": "transparent",
			"text": "📖 Same as make lint but mypy uses --strict mode.\n\n--strict enables ALL checks: no implicit Any,\nno untyped decorators, no dynamic typing anywhere.\n\nThis is the \"I want zero bugs\" mode. It's harder to\nsatisfy but catches more issues.\n\nGood for a final check before committing.",
			"fontSize": 10,
			"fontFamily": 1,
			"textAlign": "left",
			"verticalAlign": "top",
			"id": "66GNaljK",
			"roughness": 0,
			"opacity": 100,
			"elementType": "text",
			"containerId": null,
			"originalText": "📖 Same as make lint but mypy uses --strict mode.\n\n--strict enables ALL checks: no implicit Any,\nno untyped decorators, no dynamic typing anywhere.\n\nThis is the \"I want zero bugs\" mode. It's harder to\nsatisfy but catches more issues.\n\nGood for a final check before committing.",
